<resources>
    <!-- Design-system alignment with the iSDR app: accent palette and
         sentence-case buttons (never ALL CAPS). -->
    <style name="Theme.IsdrDrivers" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Painted by the window, not by the layout root: a root background on
             top of the theme's would paint every pixel twice. DayNight picks
             the light or dark value from colors.xml. -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorAccent">@color/accentBlue</item>
        <item name="colorPrimary">@color/accentBlue</item>
        <item name="buttonStyle">@style/DsButton</item>
        <item name="borderlessButtonStyle">@style/DsButtonBorderless</item>
    </style>

    <style name="DsButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DsButtonBorderless" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accentBlue</item>
    </style>
</resources>
